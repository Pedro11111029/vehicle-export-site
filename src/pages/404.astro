---
import Base from '../layouts/Base.astro';
import { PRODUCTS } from '../config/site.ts';

const title = 'Page Not Found (404)';
const description = 'The page you requested could not be found. Browse our vehicle categories or contact our sales team.';
---
<Base title={title} description={description} noindex>
  <section class="section">
    <div class="container" style="max-width: 680px; text-align: center;">
      <p class="eyebrow">Error 404</p>
      <h1>This page took a wrong turn</h1>
      <p style="color: var(--muted); font-size: 1.05rem;">
        The link may be broken or the page may have moved. Try one of these instead:
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 28px 0 40px;">
        <a class="btn btn--primary" href="/">Back to homepage</a>
        <a class="btn btn--dark" href="/contact/">Contact sales</a>
      </div>
      <div class="grid-3" style="text-align: left;">
        {PRODUCTS.map((p) => (
          <a class="card" href={`/products/${p.slug}/`}>
            <div class="card-body">
              <h3>{p.shortName}</h3>
              <span class="card-link">View specifications →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
