---
import Base from '../../layouts/Base.astro';
import { PRODUCTS, SITE } from '../../config/site.ts';

const title = `Vehicle Export Products — Cars, Trucks & NEVs | ${SITE.name}`;
const description = 'Passenger vehicles, commercial trucks and new energy vehicles available for export. View specifications, MOQ and lead times, then request a quotation.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: SITE.url + '/products/' },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: SITE.url + '/products/',
};
---
<Base title={title} description={description} jsonLd={[breadcrumbLd, collectionLd]}>
  <section class="section" style="padding-bottom: 24px;">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h1>Vehicle categories we export</h1>
      <p style="color: var(--muted); max-width: 60ch;">
        Each category can be configured for your market — steering side, emission standard, charging standard and body specification.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 8px;">
    <div class="container grid-3">
      {PRODUCTS.map((p) => (
        <a class="card" href={`/products/${p.slug}/`}>
          <div class="card-media">{p.shortName}</div>
          <div class="card-body">
            <h3>{p.name}</h3>
            <p>{p.summary.slice(0, 130)}…</p>
            <span class="card-link">View specifications →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--soft">
    <div class="container" style="text-align: center;">
      <h2>Not sure which category fits your market?</h2>
      <p style="color: var(--muted); max-width: 52ch; margin-inline: auto;">
        Tell us the destination country and intended use — we will recommend the right configuration.
      </p>
      <a class="btn btn--dark" href="/contact/">Ask a specialist</a>
    </div>
  </section>
</Base>
