---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site.ts';

const title = `Privacy Policy | ${SITE.name}`;
const description = `How ${SITE.name} collects, uses and protects personal data submitted through this website.`;
---
<Base title={title} description={description} noindex={false}>
  <section class="section">
    <div class="container prose">
      <h1>Privacy Policy</h1>
      <p style="color: var(--muted);">Last updated: {new Date().toISOString().slice(0, 10)}</p>

      <p>
        This policy explains what personal data {SITE.legalName} ("we") collects through this website,
        why we collect it, and how you can exercise your rights. It applies to visitors and to people
        who submit an inquiry form.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li><strong>Inquiry data</strong> — name, email address, company, country, product of interest and the message you send.</li>
        <li><strong>Technical data</strong> — IP address and browser user agent, recorded with your inquiry to prevent spam and abuse.</li>
        <li><strong>Cookies</strong> — this site uses no advertising or tracking cookies. We use Cloudflare Web Analytics, which does not set cookies or fingerprint visitors.</li>
      </ul>

      <h2>Why we process it</h2>
      <p>
        We use inquiry data to respond to your request, prepare quotations, fulfil orders and keep
        records required for export compliance. Our legal basis is the performance of a contract or
        steps taken at your request before entering a contract.
      </p>

      <h2>Who we share it with</h2>
      <p>
        We share data only with service providers who help us operate the site and respond to you —
        hosting (Cloudflare), transactional email (Resend) and, where an order proceeds, freight
        forwarders and customs brokers. We do not sell personal data.
      </p>

      <h2>How long we keep it</h2>
      <p>
        Inquiry records are kept for up to 24 months after our last contact, or longer where export
        or tax regulations require it.
      </p>

      <h2>Your rights</h2>
      <p>
        Depending on where you live, you may have the right to access, correct, delete or restrict
        the processing of your data, and to object to processing. To exercise any of these rights,
        email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. You also have the right to complain
        to your local data protection authority.
      </p>

      <h2>International transfers</h2>
      <p>
        Our service providers may process data outside your country. Where required, transfers are
        covered by standard contractual clauses.
      </p>

      <h2>Contact</h2>
      <p>
        {SITE.legalName}<br />
        {SITE.address}<br />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>
  </section>
</Base>
