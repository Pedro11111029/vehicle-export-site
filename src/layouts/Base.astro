---
import { SITE, NAV } from '../config/site.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const { title, description, jsonLd = [], noindex = false, ogType = 'website', ogImage: ogImagePath } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(ogImagePath ?? '/og-image.jpg', SITE.url).href;
const logoMark = SITE.name
  .split(/\s+/)
  .filter(Boolean)
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  email: SITE.email,
  telephone: SITE.phone,
  foundingDate: SITE.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: SITE.email,
    telephone: SITE.phone,
    availableLanguage: ['English', 'Chinese'],
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1b2a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Vehicle Export Insights`} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    {jsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">
          <span class="logo-mark">{logoMark}</span>
          {SITE.name}
        </a>

        <nav class="nav" id="nav">
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href.replace(/\/$/, '') || (item.href !== '/' && path.startsWith(item.href.replace(/\/$/, ''))) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-cta">
          <a class="btn btn--primary" href="/contact/">Get a Quote</a>
          <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">☰</button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>{SITE.name}</h4>
            <p style="max-width: 38ch;">{SITE.description}</p>
            <p>{SITE.address}</p>
          </div>
          <div>
            <h4>Company</h4>
            {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
          <div>
            <h4>Contact</h4>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>
            <a href="/privacy/">Privacy Policy</a>
            <a href="/terms/">Terms of Service</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {SITE.legalName}. All rights reserved.</span>
          <span><a href="/rss.xml" style="display: inline;">RSS</a> · {SITE.hours}</span>
        </div>
      </div>
    </footer>

    <a
      class="whatsapp-float"
      href={`https://wa.me/${SITE.whatsapp.replace(/[^\d]/g, '')}`}
      target="_blank"
      rel="noopener"
      aria-label="Chat on WhatsApp"
    >
      <svg width="27" height="27" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.19-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.25 8.25-8.25Zm-2.6 4.42c-.12 0-.31.04-.47.21-.16.17-.62.6-.62 1.47 0 .86.63 1.7.72 1.81.09.12 1.24 1.9 3.01 2.66.42.18.75.29 1 .37.42.13.8.11 1.1.07.34-.05 1.04-.42 1.19-.83.15-.41.15-.76.1-.83-.04-.07-.16-.12-.34-.2-.17-.09-1.04-.51-1.2-.57-.16-.06-.28-.09-.4.09-.12.17-.46.57-.56.69-.1.12-.21.13-.38.04-.17-.09-.73-.27-1.39-.86-.51-.46-.86-1.02-.96-1.19-.1-.17-.01-.27.07-.35.08-.08.17-.2.26-.31.09-.1.12-.17.18-.29.06-.12.03-.22-.01-.31-.05-.09-.4-.98-.56-1.34-.15-.36-.3-.31-.4-.31h-.35Z" />
      </svg>
    </a>

    <script is:inline>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('nav');
      toggle?.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
