---
import { PRODUCTS } from '../config/site.ts';

interface Props {
  product?: string;
  heading?: string;
}

const { product = '', heading = 'Request a Quote' } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---
<div class="form-wrap">
  <h3 style="margin-bottom: 18px;">{heading}</h3>
  <form id="inquiry-form" novalidate>
    <!-- 蜜罐字段：真实用户看不到，机器人会填 -->
    <div class="hp" aria-hidden="true">
      <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="name">Name *</label>
        <input id="name" name="name" type="text" required maxlength="80" autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Email *</label>
        <input id="email" name="email" type="email" required maxlength="120" autocomplete="email" />
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" maxlength="120" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="country">Country</label>
        <input id="country" name="country" type="text" maxlength="60" autocomplete="country-name" />
      </div>
    </div>

    <div class="field">
      <label for="product">Product of interest</label>
      <select id="product" name="product">
        <option value="">Select a category</option>
        {PRODUCTS.map((p) => (
          <option value={p.name} selected={p.name === product}>{p.name}</option>
        ))}
        <option value="Other">Other / Not sure yet</option>
      </select>
    </div>

    <div class="field">
      <label for="message">What do you need? *</label>
      <textarea id="message" name="message" required maxlength="3000" placeholder="Quantity, destination port, target price, timeline…"></textarea>
    </div>

    <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>

    <button type="submit" class="btn btn--primary" style="margin-top: 18px; width: 100%; justify-content: center;">
      Send Inquiry
    </button>

    <p class="form-note">
      We reply within 24 hours on business days. Your details are used only to respond to this inquiry.
    </p>
    <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
  </form>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLDivElement | null;
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  function show(kind: 'ok' | 'err', text: string) {
    if (!status) return;
    status.className = `form-status is-${kind}`;
    status.textContent = text;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!button) return;

    const data = Object.fromEntries(new FormData(form).entries());
    const turnstileToken =
      (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value ?? '';

    if (!data.name || !data.email || !data.message) {
      show('err', 'Please fill in your name, email and message.');
      return;
    }
    if (!turnstileToken && !String(data.website)) {
      show('err', 'Please complete the human verification.');
      return;
    }

    button.disabled = true;
    button.textContent = 'Sending…';

    try {
      const res = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...data, turnstileToken }),
      });
      const json = await res.json();

      if (res.ok && json.ok) {
        form.reset();
        (window as any).turnstile?.reset();
        show('ok', 'Thank you — your inquiry has been received. We will reply within 24 hours.');
        button.textContent = 'Sent';
      } else {
        show('err', json.error || 'Something went wrong. Please email us directly.');
        button.disabled = false;
        button.textContent = 'Send Inquiry';
      }
    } catch {
      show('err', 'Network error. Please email us directly.');
      button.disabled = false;
      button.textContent = 'Send Inquiry';
    }
  });
</script>
