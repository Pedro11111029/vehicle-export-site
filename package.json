{
  "name": "vehicle-export-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:init": "wrangler d1 execute inquiries --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute inquiries --local --file=./schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
